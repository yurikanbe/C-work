{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "プログラムを実行",
            "type": "shell",
            "command": "dotnet run --project \"${workspaceFolder}/helloconsole/helloconsole.csproj\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/helloconsole/helloconsole.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/helloconsole/helloconsole.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/helloconsole/helloconsole.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}